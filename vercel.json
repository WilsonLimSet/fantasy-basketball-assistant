{
  "regions": [
    "sin1"
  ],
  "crons": [
    {
      "path": "/api/inseason/refresh",
      "schedule": "0 11,23 * * *"
    },
    {
      "path": "/api/cron/news",
      "schedule": "0 5,15 * * *"
    },
    {
      "path": "/api/cron/breaking",
      "schedule": "*/10 * * * *"
    },
    {
      "path": "/api/inseason/lineup-check",
      "schedule": "0 16 * * *"
    },
    {
      "path": "/api/inseason/lineup-check?run=2",
      "schedule": "30 18,22 * * *"
    }
  ],
  "ignoreCommand": "bash scripts/vercel-ignore-build.sh",
  "github": {
    "silent": true
  }
}
