# ---------- In-Season (Adam) ----------
# ESPN Fantasy Basketball (Required)
# Get these from DevTools → Application → Cookies on fantasy.espn.com
ESPN_S2=your_espn_s2_cookie_value_here
ESPN_SWID={XXXXXXXX-XXXX-XXXX-XXXX-XXXXXXXXXXXX}
ESPN_LEAGUE_ID=12345678
ESPN_SEASON=2026
ESPN_MY_TEAM_ID=1

# Telegram Notifications (Required for alerts)
# Create a bot via @BotFather, then get your chat ID
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
TELEGRAM_CHAT_ID=123456789
# Public URL used in Telegram links (optional, falls back to VERCEL_URL)
APP_BASE_URL=
# Protects the /api/inseason/refresh cron endpoint (optional)
CRON_SECRET=

# ---------- Draft Kit (CourtVision) ----------
# ESPN season, by ending year (2026-27 => 2027)
CV_SEASON=2027
# Comma-separated free access codes for friends and testers
CV_ACCESS_CODES=
# Long random string that signs cookies and license keys
CV_SECRET=
# Number of players shown free (default 50)
CV_FREE_LIMIT=50
# When passes expire, e.g. 2027-07-01T00:00:00Z
CV_PASS_EXPIRES=
# Price shown in the UI, e.g. "$19 season pass"
CV_PRICE_LABEL=
# Work offline with a fixture from scripts/make-fixture.mjs
# CV_MOCK_FILE=.data/espn-mock.json

# Payments (leave unset until going live)
STRIPE_PAYMENT_LINK=
STRIPE_SECRET_KEY=
